{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolodziejm/agent-orchestration/schema/evaluation.schema.json",
  "title": "Agent orchestration evaluation contract v1",
  "oneOf": [
    {"$ref": "#/$defs/corpus"},
    {"$ref": "#/$defs/configurationCatalog"},
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "enforcement": {"enum": ["ADAPTER_ENFORCED", "PROMPT_ONLY", "OPERATOR_OWNED", "UNSUPPORTED"]},
    "dimension": {
      "type": "object",
      "required": ["value", "enforcement"],
      "properties": {"value": {"type": "string"}, "enforcement": {"$ref": "#/$defs/enforcement"}},
      "additionalProperties": false
    },
    "unavailable": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {"status": {"enum": ["NOT_COLLECTED", "UNKNOWN"]}, "reason": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "booleanMetric": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "value"],
          "properties": {"status": {"const": "OBSERVED"}, "value": {"type": "boolean"}},
          "additionalProperties": false
        },
        {"$ref": "#/$defs/unavailable"}
      ]
    },
    "countMetric": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "value"],
          "properties": {"status": {"const": "OBSERVED"}, "value": {"type": "integer", "minimum": 0}},
          "additionalProperties": false
        },
        {"$ref": "#/$defs/unavailable"}
      ]
    },
    "costMetric": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "value"],
          "properties": {
            "status": {"const": "OBSERVED"},
            "value": {
              "type": "object",
              "required": ["amount", "currency"],
              "properties": {"amount": {"type": "number", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}},
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {"$ref": "#/$defs/unavailable"}
      ]
    },
    "corpus": {
      "type": "object",
      "required": ["kind", "version", "corpus_id", "tasks"],
      "properties": {
        "kind": {"const": "evaluation-corpus"},
        "version": {"const": 1},
        "corpus_id": {"$ref": "#/$defs/identifier"},
        "tasks": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["task_id", "task_class", "title", "workspace_ref", "prompt", "acceptance"],
            "properties": {
              "task_id": {"$ref": "#/$defs/identifier"},
              "task_class": {"$ref": "#/$defs/identifier"},
              "title": {"type": "string", "minLength": 1},
              "workspace_ref": {"type": "string", "minLength": 1},
              "prompt": {"type": "string", "minLength": 1},
              "acceptance": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["acceptance_id", "command", "expected_exit_code"],
                  "properties": {"acceptance_id": {"$ref": "#/$defs/identifier"}, "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "expected_exit_code": {"type": "integer"}},
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "configurationCatalog": {
      "type": "object",
      "required": ["kind", "version", "catalog_id", "activation", "opt_in", "harness", "profile_ref", "configurations"],
      "properties": {
        "kind": {"const": "evaluation-configuration-catalog"},
        "version": {"const": 1},
        "catalog_id": {"$ref": "#/$defs/identifier"},
        "activation": {"const": "EXPERIMENT_ONLY"},
        "opt_in": {"const": true},
        "harness": {"const": "pi"},
        "profile_ref": {"$ref": "#/$defs/identifier"},
        "configurations": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["configuration_id", "summary", "activation", "turn_budget", "plan_scaffold", "action_space", "context_policy"],
            "properties": {
              "configuration_id": {"$ref": "#/$defs/identifier"},
              "summary": {"type": "string", "minLength": 1},
              "activation": {"const": "EXPERIMENT_ONLY"},
              "turn_budget": {
                "oneOf": [
                  {
                    "allOf": [{"$ref": "#/$defs/dimension"}],
                    "properties": {"value": {"const": "TASK_CALIBRATED"}}
                  },
                  {
                    "type": "object",
                    "required": ["value", "enforcement", "historical_control"],
                    "properties": {
                      "value": {"const": "HISTORICAL_FIXED"},
                      "enforcement": {"$ref": "#/$defs/enforcement"},
                      "historical_control": {
                        "type": "object",
                        "required": ["foreground_turns", "background_mutation_turns"],
                        "properties": {"foreground_turns": {"const": 12}, "background_mutation_turns": {"const": 30}},
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "plan_scaffold": {"allOf": [{"$ref": "#/$defs/dimension"}, {"properties": {"value": {"enum": ["NATIVE", "PERSISTENT"]}}}]},
              "action_space": {"allOf": [{"$ref": "#/$defs/dimension"}, {"properties": {"value": {"enum": ["FULL", "SHELL_FIRST"]}}}]},
              "context_policy": {"allOf": [{"$ref": "#/$defs/dimension"}, {"properties": {"value": {"enum": ["NATIVE", "STAGED"]}}}]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": ["kind", "version", "plan_id", "corpus_ref", "variants", "task_refs"],
      "properties": {
        "kind": {"const": "evaluation-plan"},
        "version": {"const": 1},
        "plan_id": {"$ref": "#/$defs/identifier"},
        "corpus_ref": {"$ref": "#/$defs/identifier"},
        "variants": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["variant_id", "configuration_ref"],
            "properties": {"variant_id": {"$ref": "#/$defs/identifier"}, "configuration_ref": {"$ref": "#/$defs/identifier"}},
            "additionalProperties": false
          }
        },
        "task_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      },
      "additionalProperties": false
    },
    "acceptanceEvidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["acceptance_ref", "status", "outcome", "actual_exit_code"],
          "properties": {"acceptance_ref": {"$ref": "#/$defs/identifier"}, "status": {"const": "OBSERVED"}, "outcome": {"enum": ["PASSED", "FAILED"]}, "actual_exit_code": {"type": "integer"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["acceptance_ref", "status", "reason"],
          "properties": {"acceptance_ref": {"$ref": "#/$defs/identifier"}, "status": {"enum": ["NOT_COLLECTED", "UNKNOWN"]}, "reason": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        }
      ]
    },
    "result": {
      "type": "object",
      "required": ["kind", "version", "result_id", "plan_ref", "task_ref", "variant_ref", "run_index", "metrics", "acceptance_evidence"],
      "properties": {
        "kind": {"const": "evaluation-result"},
        "version": {"const": 1},
        "result_id": {"$ref": "#/$defs/identifier"},
        "plan_ref": {"$ref": "#/$defs/identifier"},
        "task_ref": {"$ref": "#/$defs/identifier"},
        "variant_ref": {"$ref": "#/$defs/identifier"},
        "run_index": {"type": "integer", "minimum": 1},
        "metrics": {
          "type": "object",
          "required": ["task_success", "accepted_diff", "first_pass_validation", "cost", "wall_time_ms", "turns", "tool_calls", "peak_context_tokens", "compactions", "no_edit_termination", "manual_takeover", "policy_violations"],
          "properties": {
            "task_success": {"$ref": "#/$defs/booleanMetric"},
            "accepted_diff": {"$ref": "#/$defs/booleanMetric"},
            "first_pass_validation": {"$ref": "#/$defs/booleanMetric"},
            "cost": {"$ref": "#/$defs/costMetric"},
            "wall_time_ms": {"$ref": "#/$defs/countMetric"},
            "turns": {"$ref": "#/$defs/countMetric"},
            "tool_calls": {"$ref": "#/$defs/countMetric"},
            "peak_context_tokens": {"$ref": "#/$defs/countMetric"},
            "compactions": {"$ref": "#/$defs/countMetric"},
            "no_edit_termination": {"$ref": "#/$defs/booleanMetric"},
            "manual_takeover": {"$ref": "#/$defs/booleanMetric"},
            "policy_violations": {"$ref": "#/$defs/countMetric"}
          },
          "additionalProperties": false
        },
        "acceptance_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/acceptanceEvidence"}}
      },
      "additionalProperties": false
    }
  }
}
