#!/bin/sh
set -eu

pi_executable="${AGENT_ORCHESTRATION_PI_EXECUTABLE:-$HOME/.nvm/versions/node/v24.15.0/bin/pi}"
if [ ! -x "$pi_executable" ]; then
  printf '%s\n' "Pi executable is missing or not executable: $pi_executable" >&2
  exit 127
fi

export PI_CODING_AGENT_DIR="$HOME/.pi/agent"
export PI_CODING_AGENT_SESSION_DIR="$HOME/.pi/agent/sessions"
exec "$pi_executable" --model openai-codex/gpt-5.6-sol --thinking medium "$@"
