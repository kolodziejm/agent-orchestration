#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
if command -v uv >/dev/null 2>&1 && [[ "${AGENT_ORCHESTRATION_UV_RUN:-}" != "1" && -z "${VIRTUAL_ENV:-}" && -z "${UV_RUN_RECURSION_DEPTH:-}" ]]; then
  exec env AGENT_ORCHESTRATION_UV_RUN=1 uv run --locked --project "$ROOT" "$0" "$@"
fi

PYTHON="${PYTHON:-python3}"
if ! "$PYTHON" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
  printf '%s\n' 'Python 3.11+ is required; run this command with: uv run --locked ./scripts/check' >&2
  exit 2
fi

"$PYTHON" "$ROOT/adapters/validate.py"
"$PYTHON" -m unittest discover -s "$ROOT/tests" -v
"$PYTHON" "$ROOT/adapters/opencode/render.py" --output "$TMP/opencode"
diff -ruN "$ROOT/generated/opencode" "$TMP/opencode"
"$PYTHON" "$ROOT/adapters/codex/render.py" --output "$TMP/codex" --profile openai
diff -ruN "$ROOT/generated/codex" "$TMP/codex"
"$PYTHON" "$ROOT/adapters/claude-code/render.py" --output "$TMP/claude-code"
diff -ruN "$ROOT/generated/claude-code" "$TMP/claude-code"
