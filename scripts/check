#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if command -v uv >/dev/null 2>&1 && [[ "${AGENT_ORCHESTRATION_UV_RUN:-}" != "1" && -z "${VIRTUAL_ENV:-}" && -z "${UV_RUN_RECURSION_DEPTH:-}" ]]; then
  exec env AGENT_ORCHESTRATION_UV_RUN=1 uv run --locked --project "$ROOT" "$0" "$@"
fi

PYTHON="${PYTHON:-python3}"
if ! "$PYTHON" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
  printf '%s\n' 'Python 3.11+ is required; run this command with: uv run --locked ./scripts/check' >&2
  exit 2
fi

TMP="$("$PYTHON" -c 'import tempfile; print(tempfile.mkdtemp(prefix="agent-orchestration-check-"))')"
trap 'rm -rf "$TMP"' EXIT

FIRST="$TMP/first"
SECOND="$TMP/second"
OUTPUTS=(opencode codex claude-code pi/hybrid pi/openai pi/deepseek pi/glm)

generate_all() {
  local root="$1"
  "$PYTHON" "$ROOT/harnesses/opencode/generate.py" --output "$root/opencode"
  "$PYTHON" "$ROOT/harnesses/codex/generate.py" --output "$root/codex" --profile openai
  "$PYTHON" "$ROOT/harnesses/claude-code/generate.py" --output "$root/claude-code"
  "$PYTHON" "$ROOT/harnesses/pi/generate.py" --profile hybrid --output "$root/pi/hybrid"
  "$PYTHON" "$ROOT/harnesses/pi/generate.py" --profile openai --output "$root/pi/openai"
  "$PYTHON" "$ROOT/harnesses/pi/generate.py" --profile deepseek --output "$root/pi/deepseek"
  "$PYTHON" "$ROOT/harnesses/pi/generate.py" --profile glm --output "$root/pi/glm"
}

"$PYTHON" "$ROOT/harnesses/validate.py"
"$PYTHON" -m unittest discover -s "$ROOT/tests" -v

# Build every supported harness/profile output twice in independent temporary
# roots, then require byte-identical results. No committed snapshot is used or
# updated, so determinism is checked without repository output state.
generate_all "$FIRST"
generate_all "$SECOND"
for output in "${OUTPUTS[@]}"; do
  diff -ruN "$FIRST/$output" "$SECOND/$output"
done
