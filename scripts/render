#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if command -v uv >/dev/null 2>&1 && [[ "${AGENT_ORCHESTRATION_UV_RUN:-}" != "1" && -z "${VIRTUAL_ENV:-}" && -z "${UV_RUN_RECURSION_DEPTH:-}" ]]; then
  exec env AGENT_ORCHESTRATION_UV_RUN=1 uv run --locked --project "$ROOT" "$0" "$@"
fi

PYTHON="${PYTHON:-python3}"
"$PYTHON" "$ROOT/adapters/opencode/render.py" --output "$ROOT/generated/opencode"
"$PYTHON" "$ROOT/adapters/codex/render.py" --output "$ROOT/generated/codex" --profile openai
"$PYTHON" "$ROOT/adapters/claude-code/render.py" --output "$ROOT/generated/claude-code"
"$PYTHON" "$ROOT/adapters/pi/render.py" --profile hybrid --output "$ROOT/generated/pi/hybrid"
"$PYTHON" "$ROOT/adapters/pi/render.py" --profile openai --output "$ROOT/generated/pi/openai"
"$PYTHON" "$ROOT/adapters/pi/render.py" --profile deepseek --output "$ROOT/generated/pi/deepseek"
